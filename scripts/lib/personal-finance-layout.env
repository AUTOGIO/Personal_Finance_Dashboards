# Personal Finance Spencer layout — paths and verification constants.
# Sourced by restore-personal-finance-layout.zsh (do not run directly).

# Spencer profile name (ZWMPROFILE.ZNAME). "Personal Finance" was removed;
# live layout is FINANCE WORKSPACE (allSpaces, 3 displays).
LAYOUT_NAME="FINANCE WORKSPACE"

# Repo root: scripts/lib -> scripts -> repo
_LIB_DIR="${${(%):-%x}:A:h}"
REPO_ROOT="${_LIB_DIR:h:h}"

EXCEL_DOC="${REPO_ROOT}/data/command-center.xlsx"
COMET_DOC="${REPO_ROOT}/command-center.html"
CURSOR_WS="${REPO_ROOT}/Personal_Finance.code-workspace"
OBSIDIAN_VAULT="${HOME}/Documents/Obsidian"
OBSIDIAN_VAULT_NAME="Obsidian"

# Window title substrings for post-restore verification (from Spencer DB snapshot).
EXPECT_COMET_TITLE="COMMAND CENTER"
EXPECT_EXCEL_TITLE="command-center"
EXPECT_CURSOR_TITLE="Personal_Finance"
# Match any Obsidian window — Graph view is opened via obsidian://graph but
# is not required as the active tab title (Electron titles vary by note).
EXPECT_OBSIDIAN_TITLE="Obsidian"

# Display fingerprint: 3 monitors — iMac left, main LG center, secondary LG right.
REQUIRED_DISPLAY_COUNT=3
# Ultrawide resolution (UI Looks like); iMac uses scaled coordinates in Spencer.
ULTRAWIDE_WIDTH=2560
ULTRAWIDE_HEIGHT=1080

# Spencer monitor UUIDs are recorded in WORKSPACE_LAYOUT.md for reference.
# They are deliberately NOT defined here: no code reads them, and declaring
# them implied a display-identity check that verify_displays() never performed.

# Timing
APP_WAIT_TIMEOUT_SEC=45
SPENCER_POLL_TIMEOUT_SEC=30
SPENCER_RESTORE_RETRIES=2
SPENCER_RETRY_DELAY_SEC=2
